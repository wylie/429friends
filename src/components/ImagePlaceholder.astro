---
interface Props {
  label: string;
  icon?: string;
  aspect?: 'wide' | 'portrait' | 'square';
  tone?: 'leaf' | 'sun' | 'stone';
}

const { label, icon = 'landscape', aspect = 'wide', tone = 'leaf' } = Astro.props;
---

<div class:list={['image-placeholder', `image-placeholder--${aspect}`, `image-placeholder--${tone}`]} role="img" aria-label={label}>
  <div class="placeholder-sun"></div>
  <div class="placeholder-hill placeholder-hill--back"></div>
  <div class="placeholder-hill placeholder-hill--front"></div>
  <span class="placeholder-label">
    <span class="material-symbols-rounded" aria-hidden="true">{icon}</span>
    {label}
  </span>
</div>
