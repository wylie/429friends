---
import { meetingSchedule } from '../data/meetings';
import {
  formatMeetingDate,
  formatMeetingMonth,
  formatMeetingDay,
  getMeetingStatusLabel,
} from '../lib/meetings';
---

<div class="schedule-display">
  <div class="schedule-table-wrap">
    <table class="schedule-table">
      <caption class="sr-only">Upcoming 429 Friends meeting schedule</caption>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Time</th>
          <th scope="col">Status</th>
          <th scope="col">Notes</th>
        </tr>
      </thead>
      <tbody>
        {meetingSchedule.map((meeting) => (
          <tr>
            <th scope="row">{formatMeetingDate(meeting)}</th>
            <td>{meeting.time}</td>
            <td>
              <span class:list={['status-pill', `status-pill--${meeting.status}`]}>
                {getMeetingStatusLabel(meeting.status)}
              </span>
            </td>
            <td>{meeting.notes}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="schedule-card-list" aria-label="Upcoming meeting schedule">
    {meetingSchedule.map((meeting) => (
      <article class="schedule-card">
        <div class="schedule-card-date">
          <span>{formatMeetingMonth(meeting)}</span>
          <strong>{formatMeetingDay(meeting)}</strong>
        </div>
        <div class="schedule-card-content">
          <div class="meeting-card-header">
            <h3>{formatMeetingDate(meeting)}</h3>
            <span class:list={['status-pill', `status-pill--${meeting.status}`]}>
              {getMeetingStatusLabel(meeting.status)}
            </span>
          </div>
          <p class="schedule-card-time">{meeting.time}</p>
          <p>{meeting.notes}</p>
        </div>
      </article>
    ))}
  </div>
</div>
