---
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { ImageMetadata } from 'astro';

interface Action {
  label: string;
  href: string;
  style?: 'primary' | 'secondary';
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  actions?: Action[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageLabel?: string;
  imageIcon?: string;
  compact?: boolean;
}

const { eyebrow, title, description, actions = [], image, imageAlt, imageLabel, imageIcon, compact = false } = Astro.props;
---

<section class:list={['hero', compact && 'hero--compact']}>
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="hero-description">{description}</p>
      {actions.length > 0 && (
        <div class="button-row">
          {actions.map((action) => (
            <a class:list={['button', action.style === 'secondary' && 'button--secondary']} href={action.href}>
              {action.label}
              <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
            </a>
          ))}
        </div>
      )}
    </div>
    {(image || imageLabel) && (
      <div class="hero-visual reveal reveal--delay">
        <div class:list={['hero-media-frame', compact && 'hero-media-frame--compact']}>
          {image ? (
            <Image
              src={image}
              alt={imageAlt ?? ''}
              class="hero-photo"
              width={1600}
              widths={[720, 1080, 1600]}
              sizes={compact ? '(max-width: 45rem) 100vw, 38vw' : '(max-width: 45rem) 100vw, 34vw'}
              format="webp"
              loading="eager"
            />
          ) : (
            <ImagePlaceholder label={imageLabel} icon={imageIcon} aspect={compact ? 'wide' : 'portrait'} />
          )}
        </div>
        <div class="hero-note" aria-hidden="true">
          <span class="material-symbols-rounded">eco</span>
          Beneath the trees
        </div>
      </div>
    )}
  </div>
</section>
