---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ResourceList from '../components/ResourceList.astro';
import Callout from '../components/Callout.astro';
import { heroPhotos } from '../data/photos';

const resources = [
  { title: 'Quaker.org', description: 'A broad introduction to Quaker faith and practice, including shared silence and Meeting for Worship.', href: 'https://quaker.org/', label: 'Visit Quaker.org' },
  { title: 'QuakerSpeak', description: 'Short videos featuring Friends talking plainly about worship, silence, ministry, and community life.', href: 'https://quakerspeak.com/', label: 'Watch QuakerSpeak' },
  { title: 'Friends Journal', description: 'Essays, reporting, and first-person reflections from a long-running independent Quaker publication.', href: 'https://www.friendsjournal.org/', label: 'Read Friends Journal' },
  { title: 'Find a Meeting', description: 'A directory for exploring other Quaker meetings if you are traveling or looking for a different worship time.', href: 'https://www.fgcquaker.org/find-a-meeting/', label: 'Search meetings' },
];
---

<Layout title="Resources" description="Approachable resources about Quaker worship, silence, and local Friends communities.">
  <Hero compact eyebrow="Read and explore" title="For the curious." description="You do not need homework before attending. These resources are simply places to learn more about shared silence, Quaker practice, and nearby communities." image={heroPhotos.resources} imageAlt="A coral honeysuckle bloom in soft garden light." />

  <Section eyebrow="Resource shelf" title="Good places to begin" intro="These links offer plainspoken context without assuming you already know Quaker language or customs.">
    <ResourceList resources={resources} />
  </Section>

  <Section tone="soft" narrow>
    <Callout title="Experience is often the clearest explanation." icon="nature_people">
      <p>Reading can provide context, but you are also welcome to simply join us and see how the meeting feels.</p>
      <a class="text-link" href="/first-time-here/">Start with the visitor guide<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></a>
    </Callout>
  </Section>
</Layout>
