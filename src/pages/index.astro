---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Callout from '../components/Callout.astro';
import Gallery from '../components/Gallery.astro';
import NextMeetingDisplay from '../components/NextMeetingDisplay.astro';
import CountdownToNextMeeting from '../components/CountdownToNextMeeting.astro';
import { siteConfig } from '../config/site';
import { backyardGallery, heroPhotos } from '../data/photos';
---

<Layout>
  <Hero
    eyebrow="Hendersonville, North Carolina"
    title="A quiet hour, shared outdoors."
    description="429 Friends is a monthly backyard Silent Meeting rooted in the Quaker tradition of Meeting for Worship. Whether you know that practice well or are simply curious about shared silence, there is a place for you in the circle."
    image={heroPhotos.home}
    imageAlt="The shaded backyard lawn at 429 Friends beneath broad tree branches."
    actions={[
      { label: 'Plan your first visit', href: '/first-time-here/' },
      { label: 'See meeting dates', href: '/schedule/', style: 'secondary' },
    ]}
  />

  <Section eyebrow="What happens here" title="Stillness can be shared." intro="Friends often call this kind of worship a Silent Meeting. We gather without a program or a leader, settle into shared quiet, and make room to listen to ourselves, to one another, and to what matters most.">
    <div class="card-grid card-grid--three">
      <Card title="Arrive as you are" icon="diversity_1" href="/visit/" linkLabel="How to visit">
        <p>No special knowledge, beliefs, or preparation are required. Bring a chair and join the circle.</p>
      </Card>
      <Card title="Share the silence" icon="quiet_time" href="/about/" linkLabel="About the meeting">
        <p>We sit together for about an hour. There is no sermon or planned service, and anyone may speak if something feels important to share.</p>
      </Card>
      <Card title="Stay and connect" icon="local_cafe">
        <p>After worship, the quiet gives way to easy conversation and time to know our neighbors.</p>
      </Card>
    </div>
  </Section>

  <Section tone="soft" eyebrow="The setting" title="A backyard, not a sanctuary." intro="The meeting takes place at a private home beneath the trees. Seasonal details change; the welcome does not.">
    <Gallery items={backyardGallery} />
  </Section>

  <Section eyebrow="When we meet" title={`${siteConfig.meeting.cadence}, outdoors.`} intro={`${siteConfig.meeting.duration}, followed by ${siteConfig.meeting.communityTime.toLowerCase()}.`}>
    <div class="meeting-highlight-grid">
      <NextMeetingDisplay />
      <CountdownToNextMeeting />
    </div>
  </Section>

  <Section narrow>
    <Callout title="Ready for a first visit?" icon="calendar_month" tone="sun">
      <p>Children are welcome alongside adults. Bring your own chair, arrive quietly if the meeting has begun, and use the right-side path into the backyard.</p>
      <div class="button-row">
        <a class="button" href="/schedule/">View the schedule<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></a>
        <a class="button button--secondary" href="/contact/">Ask a question</a>
      </div>
    </Callout>
  </Section>
</Layout>
